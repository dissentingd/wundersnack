  "_blocklistDoc": "Each entry is a case-insensitive regex matched at the start of a word (e.g. 'war\\b' blocks 'war' but not 'warbler').",
  "votes": {
    "_doc": "Anonymous 'Helped?' totals from the site's /api/totals. score = (up+1)/(up+down+2); items with at least minVotes votes and a score below dropBelow are left out of the feed.",
    "totalsUrl": "https://wundersnack.com/api/totals",
    "minVotes": 8,
    "dropBelow": 0.25
  },
  "mediaCache": {
    "_doc": "Our own H.264 copies of Wikimedia Commons videos (see scripts/cache-media.mjs). Served publicly from baseUrl (an R2 bucket's custom domain).",
    "bucket": "wundersnack-media",
    "baseUrl": "https://media.wundersnack.com",
    "maxBytes": 9000000000,
    "_budgetDoc": "Storage budget for the bucket (R2 Standard storage: 10 GB free). Upload runs prune copies of items no longer in the feed, then evict the worst-voted copies (helped < 50%) before skipping new items."
  },
  "grossButCool": {
    "_doc": "Items whose title, subtitle, caption or topic match one of these (case-insensitive regex at a word start) are flagged gross: true. The app hides them unless the viewer turns on \"Gross, but cool\". Taxa can also be flagged wholesale with grossButCool in inaturalist.taxa. Items from skipSources are never flagged.",
    "patterns": [
      "(a|the|long-legged|house|hover|crane|robber|blow|horse|fruit|bee|soldier|snipe|flesh|dance|stable|bot|deer|sand|black|march|scorpion|stilt|thick-headed|picture-winged)[ -]?fl(y|ies)\\b",
