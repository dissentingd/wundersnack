      "millipedes?\\b",
      "earwigs?\\b",
      "ticks?\\b",
      "mites?\\b",
      "leech(es)?\\b",
      "lice\\b",
      "louse\\b",
      "fleas?\\b",
      "bed ?bugs?\\b",
      "(?<!sea )slugs?\\b",
      "locusts?\\b",
      "mosquito(e?s)?\\b",
      "gnats?\\b",
      "midges?\\b",
